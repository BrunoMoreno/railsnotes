# Copy to `.env` and adjust as needed: `cp .env.example .env`
# `.env` is loaded automatically by `docker compose` (and Rails via dotenv/foreman in dev).

# --- PostgreSQL connection (shared by local, Docker and CI) ---
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=notesapp
DB_PASSWORD=password

# --- App ---
# Port exposed by `docker compose` for the Rails app
PORT=3000

# --- Production ---
# Generate with `bin/rails credentials:edit` (if set, image already carries it via secrets)
RAILS_MASTER_KEY=